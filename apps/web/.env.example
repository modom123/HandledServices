# ============================================================
# FILE    : apps/web/.env.example   (copy to .env.local / Vercel env)
# PROJECT : Handled
# CREATED : 2026-10-01_1723 UTC
# UPDATED : 2026-10-05_0148 UTC — company mailbox (SMTP_USER / SMTP_PASSWORD) for the Email Center.
# UPDATED : 2026-10-06_0708 UTC — STRIPE_PUBLISHABLE_KEY for Apple Pay / Google Pay in the mobile app.
# UPDATED : 2026-10-05_0434 UTC — OWNER_EMAILS (first admins).
# UPDATED : 2026-10-05_1441 UTC — SAM_API_KEY (government contracts from SAM.gov).
# UPDATED : 2026-10-06_1956 UTC — every variable the code reads is now listed (Twilio texts, Checkr, Stripe Tax, IMAP/SMTP hosts,
#           business-lead campaign, cron flag). Supabase URL + publishable key are built in (override here for staging).
# UPDATED : 2026-10-06_2230 UTC — Xero accounting (XERO_CLIENT_ID / XERO_CLIENT_SECRET, optional overrides).
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # production: https://your-domain (every email link uses it)

# Public contact details shown on the site, invoices and emails
NEXT_PUBLIC_SUPPORT_EMAIL=info@handledsvc.com   # built in
NEXT_PUBLIC_SUPPORT_PHONE=(313) 639-9373   # built in
# Google Business Profile → "Ask for reviews" link; customers are invited to review us on Google after rating a job
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://qpzkayrfcunzelnhcrff.supabase.co   # built in; set only to point at another project
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_AoOckoK73PvM96_bMr0Obg_ZGZykQZ1   # public by design; built in
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — never expose

# Claude (AI quoting, dispatch, QA, concierge, ops assistant)
ANTHROPIC_API_KEY=sk-ant-...

# Payments (optional — without it customers pay after service)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Apple Pay / Google Pay in the app (Stripe → Developers → API keys). Not a secret. Also add the
# payment_intent.succeeded event to the Stripe webhook.
STRIPE_PUBLISHABLE_KEY=

# SITE_THEME = default website look: classic | greengold | modern | bwg (Hub → Website setting overrides it).
SITE_THEME=

# Accounting — Xero is the books; Stripe activity is pushed every morning (Hub → Accounting (Xero)).
# developer.xero.com → My Apps → New app → Web app. Redirect URI: https://your-domain/api/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional: XERO_REDIRECT_URI (defaults to NEXT_PUBLIC_SITE_URL/api/xero/callback), XERO_TENANT_ID (pick one org when
# you authorise several), XERO_TOKEN_KEY (encrypts the saved Xero login; defaults to the client secret), XERO_SCOPES
# (only for Xero apps created before 2 March 2026 that still use the broad scopes).

# Email notifications (optional — Resend)
RESEND_API_KEY=
# Company mailbox (Hostinger) — Email Center marketing + inbox; also sends booking emails when RESEND_API_KEY is empty.
# Set the real password in Vercel only (never in chat, email or git).
# Owners: these emails are Hub admins from their first sign-in (comma-separated). Add other staff in Hub → Team.
OWNER_EMAILS=
SMTP_USER=info@handledsvc.com
SMTP_PASSWORD=
# Optional (Hostinger defaults): SMTP_HOST=smtp.hostinger.com SMTP_PORT=465 IMAP_HOST=imap.hostinger.com IMAP_PORT=993
EMAIL_FROM="Handled <info@handledsvc.com>"   # built in
OPS_EMAIL=info@handledsvc.com   # built in: alerts + morning brief

# Vercel cron auth (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=change-me

# Send offers to pros automatically right after booking (true/false)
AUTO_DISPATCH=true

# IEBC Workforce API — shared secret the IEBC MasterHub sends as "Authorization: Bearer ..."
# Generate with: openssl rand -hex 32
IEBC_API_KEY=
# Restrict browser calls to the MasterHub's origin (e.g. https://hub.iebc.example); "*" if unset
IEBC_ALLOWED_ORIGIN=

# Signs the login-free invoice links in emails (falls back to the service role key)
INVOICE_SIGNING_SECRET=

# Push notifications (Expo push service). Optional but recommended: expo.dev → Access tokens
EXPO_ACCESS_TOKEN=

# Pro lead engine (Hub → Pro leads). Google Places finds pros; Instantly.ai sends the invitations from
# warmed-up inboxes on a SEPARATE domain (never your booking-email domain). Postal address is required by CAN-SPAM.
GOOGLE_PLACES_API_KEY=
# Exact distances (customer address -> pro's place of business): Google Geocoding API. Falls back to ZIP centres.
GOOGLE_MAPS_API_KEY=
# Government contracts (Hub → Gov contracts): SAM.gov → Workspace → profile → Public API Key. Type it into Vercel only.
SAM_API_KEY=
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
INSTANTLY_WEBHOOK_SECRET=
BUSINESS_POSTAL_ADDRESS=

# Text messages (Twilio) — offers, "on my way", backup calls, customer updates. Without it, texts are skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=   # or TWILIO_FROM=+13135550100
TWILIO_FROM=

# Background checks (Checkr) — orders checks for approved pros. Without it, staff record checks by hand.
CHECKR_API_KEY=
CHECKR_PACKAGE=

# Business sales engine (Hub → Business leads) — Instantly campaign for business outreach
INSTANTLY_BIZ_CAMPAIGN_ID=

# Stripe Tax on Handled Plus memberships (on/off)
STRIPE_TAX=

# The 10-minute dispatch cron runs on GitHub Actions (set to "github" so Hub → Setup shows it as covered)
DISPATCH_CRON=github

