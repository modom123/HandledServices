# ============================================================
# FILE    : apps/web/.env.example   (copy to .env.local / Vercel env)
# PROJECT : Handled
# CREATED : 2026-10-01_1723 UTC
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # production: https://your-domain (every email link uses it)

# Public contact details shown on the site, invoices and emails
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
NEXT_PUBLIC_SUPPORT_PHONE=(313) 555-0100
# Google Business Profile → "Ask for reviews" link; customers are invited to review us on Google after rating a job
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — never expose

# Claude (AI quoting, dispatch, QA, concierge, ops assistant)
ANTHROPIC_API_KEY=sk-ant-...

# Payments (optional — without it customers pay after service)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email notifications (optional — Resend)
RESEND_API_KEY=
EMAIL_FROM="Handled <hello@handled.example>"
OPS_EMAIL=ops@handled.example

# Vercel cron auth (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=change-me

# Send offers to pros automatically right after booking (true/false)
AUTO_DISPATCH=true

# IEBC Workforce API — shared secret the IEBC MasterHub sends as "Authorization: Bearer ..."
# Generate with: openssl rand -hex 32
IEBC_API_KEY=
# Restrict browser calls to the MasterHub's origin (e.g. https://hub.iebc.example); "*" if unset
IEBC_ALLOWED_ORIGIN=

# Signs the login-free invoice links in emails (falls back to the service role key)
INVOICE_SIGNING_SECRET=

# Push notifications (Expo push service). Optional but recommended: expo.dev → Access tokens
EXPO_ACCESS_TOKEN=

# Pro lead engine (Hub → Pro leads). Google Places finds pros; Instantly.ai sends the invitations from
# warmed-up inboxes on a SEPARATE domain (never your booking-email domain). Postal address is required by CAN-SPAM.
GOOGLE_PLACES_API_KEY=
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
INSTANTLY_WEBHOOK_SECRET=
BUSINESS_POSTAL_ADDRESS=
