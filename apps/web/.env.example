# ============================================================
# FILE    : apps/web/.env.example   (copy to .env.local / Vercel env)
# PROJECT : Handled
# CREATED : 2026-10-01_1723 UTC
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — never expose

# Claude (AI quoting, dispatch, QA, concierge, ops assistant)
ANTHROPIC_API_KEY=sk-ant-...

# Payments (optional — without it customers pay after service)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email notifications (optional — Resend)
RESEND_API_KEY=
EMAIL_FROM="Handled <hello@handled.example>"
OPS_EMAIL=ops@handled.example

# Vercel cron auth (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=change-me

# Send offers to pros automatically right after booking (true/false)
AUTO_DISPATCH=true

# IEBC Workforce API — shared secret the IEBC MasterHub sends as "Authorization: Bearer ..."
# Generate with: openssl rand -hex 32
IEBC_API_KEY=
# Restrict browser calls to the MasterHub's origin (e.g. https://hub.iebc.example); "*" if unset
IEBC_ALLOWED_ORIGIN=
