{
  "expo": {
    "name": "Handled",
    "slug": "handled",
    "scheme": "handled",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.handled.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.handled.app",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e7c66"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Handled uses your photos to price jobs and prove completed work.",
          "cameraPermission": "Handled uses the camera so you can photograph the job for an accurate price, and so pros can show finished work."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0e7c66",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pros: Handled uses your location only while you're on call or on a job today, to send you nearby work and tell customers you're on the way."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.handled.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0a4a3e"
        }
      ]
    ],
    "extra": {
      "createdAt": "2026-10-01_1800 UTC",
      "project": "Handled (HandledServices) mobile app",
      "privacyPolicyUrl": "filled from EXPO_PUBLIC_API_URL by app.config.js",
      "termsUrl": "filled from EXPO_PUBLIC_API_URL by app.config.js",
      "updatedAt": "2026-11-10_2130 UTC — v1.0.0 for the App Store and Google Play: Expo project id comes from `eas init` (or EAS_PROJECT_ID); production builds refuse to build without their server settings"
    },
    "description": "Book cleaning, power washing, lawn and snow, pet care, hauling, repairs, painting, remodels, errands, events and rides (black car, limo, party bus) with upfront prices — and run your jobs if you're a Handled pro.",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
